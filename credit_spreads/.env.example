# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Kite Connect app credentials (developers.kite.trade). Needed from milestone 2.
# There is no stored refresh token: the owner logs in each morning (SEBI daily 2FA rule).
KITE_API_KEY=
KITE_API_SECRET=

# Telegram bot for alerts, approvals and /kill. Needed from milestone 7.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Live-order confirmation flag. Leave unset. Real orders need BOTH `mode: live` in
# config.yaml AND this set to exactly: yes-real-money
# LIVE_TRADING_CONFIRMED=
